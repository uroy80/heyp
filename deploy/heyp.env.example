# /etc/heyp/heyp.env — settings for the heyp stack on this server (root:deploy, mode 0640). Never in git.
# Written for the production server: heyp at https://heyp.edgr.in on a Hostinger VPS (AlmaLinux 10, 4 vCPU / 15 GB,
# Docker ≥ 28) where Apache httpd owns 80/443 for several sites and Cloudflare proxies the names, with a Cloudflare
# Origin certificate on Apache (deploy/DEPLOY.md). heypdf runs next to it as its own stack on 127.0.0.1:8181.
#
#   sudo bash /tmp/heyp/deploy/bootstrap-vps.sh --ci-key "ssh-ed25519 AAAA… heyp-ci" --egress-guard
#
# copies this file to /etc/heyp/heyp.env and fills in HEYP_EGRESS_DENY_CIDRS / HEYP_EGRESS_SECRET.
# heyp-deploy passes it to docker compose as the first --env-file; values sent by CI (PROD_ENV secret, HEYP_* keys only,
# never the network/firewall keys) and the release tag override it. Changes apply on the next deploy; to apply them
# now, redeploy the running release (--keep-ci-env keeps the values CI sent last time):
#   sudo -u deploy /usr/local/sbin/heyp-deploy deploy "$(cat /srv/heyp/state/current)" --keep-ci-env

# --- public address --------------------------------------------------------------------------------------------------
HEYP_DOMAIN=heyp.edgr.in
# Defaults to https://HEYP_DOMAIN; set it only if the public URL differs (e.g. a non-standard port).
#HEYP_PUBLIC_URL=https://heyp.edgr.in
# heypdf, the PDF toolbox: the "heyp · heypdf" switch links here and old /pdf/* addresses answer 308 to it ("off" hides
# both). A plain link — files never move between the two apps.
HEYP_SIBLING_URL=https://heypdf.edgr.in

# --- Apache proxies to the app on this loopback port ------------------------------------------------------------------
#   render   HTML → image (renderer + egress proxy; host guard: bootstrap-vps.sh --egress-guard)
COMPOSE_PROFILES=render
HEYP_BIND=127.0.0.1
# Must equal the port in the two ProxyPass lines of deploy/apache/ssl-heyp.conf. Taken on this server: 3000, 4416, 8100
# (other sites) and 8181 (heypdf).
HEYP_PORT=8180
# HEYP_TRUSTED_PROXIES stays at its default (the edge network): Apache's connections to the published loopback port
# reach the app from that network's gateway. Apache itself turns CF-Connecting-IP into the visitor's address.

# --- operator: shown on /privacy and /terms (required; the app refuses hosted mode without name + e-mail) ---------------
HEYP_OPERATOR_NAME="Usham Roy"
HEYP_OPERATOR_EMAIL=support@edgr.in
# India IT Rules: named grievance officer (defaults to the operator).
HEYP_GRIEVANCE_OFFICER="Usham Roy"
# Country you operate from (defaults to HEYP_JURISDICTION) and the law that governs the terms.
HEYP_OPERATOR_COUNTRY=India
HEYP_JURISDICTION=India
#HEYP_POSTAL_ADDRESS=
# The launch date (YYYY-MM-DD); change it whenever legal/*.md changes in a way that matters.
HEYP_EFFECTIVE_DATE=
# hPanel → VPS → Overview, e.g. "India" or "Lithuania (EU)". Shown in "Where your data goes".
HEYP_SERVER_LOCATION=
HEYP_HOSTING_PROVIDER=Hostinger
# Cloudflare terminates HTTPS for this name and so carries every upload and result: /privacy and /terms name it.
HEYP_CDN_PROVIDER=Cloudflare
HEYP_CDN_DPA_URL=https://www.cloudflare.com/cloudflare-customer-dpa/
# Optional: GDPR Art. 27 representatives, DMCA agent, separate inboxes, liability cap wording.
#HEYP_EU_REPRESENTATIVE=
#HEYP_UK_REPRESENTATIVE=
#HEYP_DMCA_AGENT=
#HEYP_SECURITY_EMAIL=
#HEYP_ABUSE_EMAIL=
#HEYP_LIABILITY_CAP=

# --- logs: printed on /privacy, so they must match reality (deploy/apache/logrotate-heyp keeps Apache's this long) -----
HEYP_LOG_RETENTION_DAYS=14
# Hostinger's automatic weekly VPS backups keep 2 copies (~14 days); 0 if they are off.
HEYP_BACKUP_RETENTION_DAYS=14
HEYP_LOG_IP_TRUNCATED=0

# --- files: Cloudflare accepts at most 100 MB per request, so one file stays below it -----------------------------------
HEYP_TTL_MINUTES=60
HEYP_HARD_TTL_MINUTES=240
HEYP_MAX_UPLOAD_MB=90
# One upload request stays under Cloudflare's cap too: the server refuses bigger ones and the UI batches to it.
HEYP_MAX_REQUEST_MB=95
HEYP_MAX_FILES=50
HEYP_MAX_PIXELS=50000000

# --- image models (empty = defaults) -----------------------------------------------------------------------------------
# Largest photo Upscale accepts, in megapixels (default 6).
#HEYP_UPSCALE_MAX_INPUT_MP=6
# Background removal model: fp32 (default; best edges) or int8 (smaller download, ~same speed and peak memory).
#HEYP_MATTING_MODEL=int8
# Threads per model run (default: from the CPU quota) and face/plate detections at once (default 1).
#HEYP_AI_THREADS=2
#HEYP_DETECT_CONCURRENCY=1

# --- web-page capture: filled in by bootstrap-vps.sh ------------------------------------------------------------------
# This server's public IPs (comma-separated CIDRs, e.g. 147.93.18.165/32), which the egress proxy refuses — otherwise
# a captured page could reach other sites and admin panels on this VPS. Add every public IP the VPS has.
HEYP_EGRESS_DENY_CIDRS=
# Shared secret between the renderer and the egress proxy (openssl rand -hex 32).
HEYP_EGRESS_SECRET=

# --- capacity: 4 vCPU / 15 GB shared with heypdf and the other sites -------------------------------------------------------
# Ceilings, not reservations (idle ≈ 0.8 GB): app 4 GB (its RAM /tmp with the uploads counts here), renderer 1 GB,
# egress 128 MB ≈ 5.1 GB. No container may take all 4 CPUs.
HEYP_MEM_LIMIT=4g
HEYP_TMP_SIZE=1g
HEYP_CPUS=2
HEYP_CACHE_MB=384
HEYP_LANE_LIGHT=2
HEYP_LANE_HEAVY=1
HEYP_RENDERER_MEM_LIMIT=1g
HEYP_RENDERER_CPUS=1.0

# --- networks: change only if `docker network inspect` shows another network on these subnets -------------------------
# The edge network's subnet is also the default HEYP_TRUSTED_PROXIES; the egress subnet is what the guard matches.
# heypdf's stack must use subnets of its own.
#HEYP_EDGE_SUBNET=172.31.251.0/24
#HEYP_EGRESS_SUBNET=172.31.252.0/24
